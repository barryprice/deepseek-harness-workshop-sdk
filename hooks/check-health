#!/usr/bin/bash
if ! sudo -u workshop --login dsh --help >/dev/null 2>&1; then
    workshopctl set-health error "dsh not available on PATH"
    exit 0
fi
echo -n "DeepSeek Harness ready. Run 'dsh web' for the web UI (http://127.0.0.1:3080) or 'dsh --profile headless \"…\"'. Provide a DeepSeek API key before starting a session."
workshopctl set-health okay
