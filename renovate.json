{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigestsToSemver"
  ],
  "enabledManagers": [
    "custom.regex",
    "github-actions"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^VERSION$/"],
      "matchStrings": [
        "(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.]+)?)"
      ],
      "depNameTemplate": "@deepseek-ai/dsh",
      "datasourceTemplate": "npm",
      "versioningTemplate": "npm"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^sdkcraft\\.yaml$/"],
      "matchStrings": [
        "npm-node-version:\\s*[\"']?(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)[\"']?"
      ],
      "depNameTemplate": "node",
      "datasourceTemplate": "node",
      "versioningTemplate": "node"
    }
  ],
  "baseBranchPatterns": [
    "latest"
  ],
  "packageRules": [
    {
      "matchPackageNames": ["@deepseek-ai/dsh"],
      "matchBaseBranches": ["latest"],
      "ignoreUnstable": false,
      "followTag": "alpha"
    },
    {
      "matchPackageNames": ["node"],
      "matchBaseBranches": ["latest"],
      "versioning": "node",
      "respectLatest": true,
      "major": { "enabled": false }
    }
  ]
}
